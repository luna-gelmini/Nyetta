# Copy to .env in the repo root (same folder you run java -jar from).
# .env is gitignored. Real tokens never go in src/main/resources.

# --- Auth ---
APPLICATION_ID=
CLIENT_SECRET=
BOT_TOKEN=your_fluxer_bot_token_here

# --- Guild ---
# GUILD_ID=

# --- Commands ---
COMMAND_PREFIX=!

# --- Channels ---
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=

# --- Roles ---
AUTO_ASSIGN_ROLE_ID=
XP_ROLE_LEVEL_5=
XP_ROLE_LEVEL_40=
XP_ROLE_LEVEL_80=

# --- Temporary voice ---
HUB_CHANNEL_ID=
TEMP_CHANNEL_CATEGORY_ID=
TEMP_CHANNEL_NAME_PREFIX="Sala de "
TEMP_CHANNEL_USER_LIMIT=5
TEMP_CHANNEL_DEFAULT_LOCKED=0

# --- Presence ---
BOT_STATUSES="online, thinking"

# --- Fluxer endpoints (optional) ---
# API_BASE_URL=https://api.fluxer.app/v1
# GATEWAY_URL=wss://gateway.fluxer.app
# MEDIA_CDN_URL=https://fluxerusercontent.com
# APP_BASE_URL=https://web.fluxer.app
